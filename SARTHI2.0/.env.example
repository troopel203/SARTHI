# SARTHI 2.0 — copy this file to ".env" and fill in what you have.
# Leave everything blank to run in DEMO mode (works instantly, no signup).

# --- Production backend (Supabase) -----------------------------------------
# Free forever on Supabase's free tier. Get these from:
# supabase.com → New project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Real AI ranking rationale (Google Gemini) ------------------------------
# Free tier, no credit card. Get a key: aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# --- Real cross-device push notifications -----------------------------------
# Free forever, self-generated (no external account needed). Run:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here, and the PRIVATE key as a Supabase Edge Function
# secret (see README) — never put the private key in this file.
VITE_VAPID_PUBLIC_KEY=
